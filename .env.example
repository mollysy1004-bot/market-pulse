# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed or shared.

# --- Reddit ---------------------------------------------------------------
# Not read by anything yet. Collection currently takes raw dumps from a browser
# session; these are for the OAuth client that replaces it. See README step 1.
# reddit.com/prefs/apps -> create app -> type "script"
# The client ID is the short string under the app name, NOT the app name.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent or it will rate-limit you hard.
REDDIT_USER_AGENT=market-pulse/0.1 by /u/YOUR_REDDIT_USERNAME

# --- Anthropic ------------------------------------------------------------
# console.anthropic.com -> API keys -> Create key. Shown once, starts sk-ant-
ANTHROPIC_API_KEY=
